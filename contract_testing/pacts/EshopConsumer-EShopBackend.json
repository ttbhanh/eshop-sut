    {
      "description": "a request to add item to cart",
      "providerStates": [
        {
          "name": "a valid auth token exists, user cart is empty, and product with ID 1 exists"
        }
      ],
      "request": {
        "body": {
          "id": 1,
          "name": "iPhone 15 Pro Max",
          "price": 30000000,
          "quantity": 2
        },
        "headers": {
          "Authorization": "Bearer mock-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/cart"
      },
      "response": {
        "body": {
          "message": "Added to cart"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
